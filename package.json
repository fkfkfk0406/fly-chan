{
  "name": "fly-chan",
  "private": true,
  "version": "0.1.4",
  "type": "module",
  "scripts": {
    "data": "pipeline/.venv/Scripts/python pipeline/fetch_data.py && pipeline/.venv/Scripts/python pipeline/build_connectome.py",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "probe": "node scripts/probe.ts",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "desktop:build": "tauri build",
    "release": "npm version patch -m \"release: v%s\" && git push --follow-tags"
  },
  "dependencies": {
    "@pixiv/three-vrm": "^3.5.5",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-http": "^2.6.1",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.11.0",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^26.5.1",
    "@types/three": "^0.186.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
