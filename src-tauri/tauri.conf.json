{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fly-chan",
  "version": "../package.json",
  "identifier": "io.github.fkfkfk0406.flychan",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "플라이쨩",
        "width": 380,
        "height": 680,
        "minWidth": 320,
        "minHeight": 520,
        "decorations": false,
        "resizable": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Korean"
        ]
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEExMjJGQzgwNUUzM0ZFQzMKUldURC9qTmVnUHdpb1RDR0Z0UzNrMEg0T0lBYUNsYzRtSnM0bHQ5UmlsSnRCRlVRSSs1cnhjeCsK",
      "endpoints": [
        "https://github.com/fkfkfk0406/fly-chan/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
